# feedsystem_video_go 环境变量模板
# 复制此文件为 .env 后修改实际值
# .env 已被 .gitignore 忽略，不会提交到仓库
# .env：存敏感信息（密码、密钥），方便不同环境切换，
# 且被 .gitignore 忽略，不提交到仓库
# config.json：存结构化的技术配置（端口、地址、pprof 开关等）

# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=agora
MYSQL_HOST_PORT=3307

# Redis
REDIS_PASSWORD=123456
REDIS_HOST_PORT=6380

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=password123
RABBITMQ_AMQP_HOST_PORT=5673
RABBITMQ_MANAGEMENT_HOST_PORT=15673

# JWT (生产环境务必修改为随机强密钥)
JWT_SECRET=agora-dev-secret-key

# distcache 内容详情 L1 节点。当前 Compose 只有一个 API，因此使用单节点。
# 三 API 示例：DISTCACHE_NODES=api1:9001,api2:9001,api3:9001
DISTCACHE_ADDR=127.0.0.1:9001
DISTCACHE_NODES=127.0.0.1:9001

CONFIG_PATH=configs/config.compose-local.json
